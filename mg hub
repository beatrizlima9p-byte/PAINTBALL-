-- Função para encontrar servidores
local function FindServers()
    local servers = {}
    local page = 1
    while true do
        local success, body = pcall(function()
            return HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100&cursor="..(page > 1 and page or "")))
        end)
        if not success or not body or not body.data then break end

        for _, server in pairs(body.data) do
            if server.playing < server.maxPlayers and server.id ~= game.JobId then
                table.insert(servers, server.id)
            end
        end

        if not body.nextPageCursor then break end
        page = page + 1
    end
    return servers
end

-- Loop Server Hop Automático
task.spawn(function()
    while true do
        if Config.ServerHopEnabled then
            local servers = FindServers()
            if #servers > 0 then
                local randomServer = servers[math.random(1, #servers)]
                StatusLabel.Text = "Server Hop: Encontrado servidor " .. randomServer
                print("Teleportando para servidor: "..randomServer)
                TeleportService:TeleportToPlaceInstance(game.PlaceId, randomServer, LocalPlayer)
                break -- após teleport, o script continuará no novo servidor
            else
                StatusLabel.Text = "Server Hop: Nenhum servidor disponível"
            end
        end
        task.wait(5)
    end
end)

-- Persistência após teleport
Players.PlayerAdded:Connect(function()
    task.wait(1)
    if Config.ServerHopEnabled then
        print("Script reiniciado após teleport, Server Hop ON")
    end
end)

